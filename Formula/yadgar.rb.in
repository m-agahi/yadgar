# Homebrew formula template for yadgar.
# Placeholders: @VERSION@, @SHA256@, @PYTHON_VERSION@
#
# This template lives in the yadgar repo. The release workflow renders it
# and opens a PR against the homebrew-yadgar tap repo.
#
# Python version note:
#   pyproject.toml requires Python >=3.14. As of 2026-06, python@3.14 is not
#   yet available in Homebrew core (typical 1-2 month lag after CPython release).
#   Template uses @PYTHON_VERSION@ placeholder. Release workflow resolves to
#   python@3.14 when available, else falls back to python@3.13 and appends
#   a warning comment.
#
# Distribution: Formula/yadgar.rb.in lives in yadgar repo.
#               Formula/yadgar.rb lives in homebrew-yadgar tap repo (auto-updated).
#               Tap URL: https://codeberg.org/maxagahi/homebrew-yadgar

class Yadgar < Formula
  include Language::Python::Virtualenv

  desc "Persistent memory engine for Claude Code — heat decay, sleep consolidation, surprise-gated storage"
  homepage "https://codeberg.org/maxagahi/yadgar"
  url "https://files.pythonhosted.org/packages/source/y/yadgar/yadgar-@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "Apache-2.0"
  version "@VERSION@"

  # Python version: python@3.14 preferred; fall back to python@3.13 if 3.14 not in Homebrew core.
  # See: https://codeberg.org/maxagahi/yadgar/docs/INSTALL.md#homebrew
  depends_on "python@@PYTHON_VERSION@"
  depends_on "podman" => :recommended
  depends_on "docker" => :optional

  def install
    virtualenv_install_with_resources

    # Install yadgar-setup as a standalone binary so users can run setup
    # without a repo checkout (Option C: separate binary, not CLI subcommand).
    # The wheel ships yadgar-setup.sh at share/yadgar/scripts/yadgar-setup.sh.
    setup_sh = libexec/"share/yadgar/scripts/yadgar-setup.sh"
    if setup_sh.exist?
      bin.install setup_sh => "yadgar-setup"
      chmod 0755, bin/"yadgar-setup"
    end
  end

  def caveats
    <<~EOS
      Yadgar installed. Run `yadgar-setup` to complete setup:

        yadgar-setup

      This configures ~/.yadgar/, installs daemon units (systemd or launchd),
      Claude Code hooks, subagent templates, config, rules, and seed anchors.

      Re-run `yadgar-setup` after upgrades to pick up new defaults.

      macOS note: v5.45.1 launchd support is included. Run `yadgar-setup --doctor`
      to verify the daemon is running after first install.

      Non-interactive install (e.g. CI, automation):
        yadgar-setup --noninteractive

      See: https://codeberg.org/maxagahi/yadgar
    EOS
  end

  test do
    # Verify yadgar CLI responds with version
    assert_match "yadgar #{version}", shell_output("#{bin}/yadgar --version 2>&1 || true")
    # Verify yadgar-setup --dryrun exits 0
    system "#{bin}/yadgar-setup", "--dryrun"
  end
end

# Yadgar systemd user service template
# Generated by: yadgar daemon install-service
# Install:  cp yadgar.service ~/.config/systemd/user/
#           systemctl --user enable yadgar
#           systemctl --user start yadgar

[Unit]
Description=Yadgar Memory Engine
After=network.target

[Service]
Type=simple
ExecStart=python3 -m yadgar --transport streamable-http --port 8765 --quiet
Restart=on-failure
RestartSec=5
Environment=YADGAR_PORT=8765

[Install]
WantedBy=default.target

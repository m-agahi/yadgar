# ── yadgar-ci-viz: Viz-test CI runner image ────────────────────────────────────
# Extends yadgar-ci with Playwright + Chromium for viz integration tests.
# Purpose: used by .forgejo/workflows/ci.yaml viz-tests job.
#
# Separating viz from core avoids a 100+ MB Playwright/Chromium layer in the
# base image (core tests don't need a browser). The split saves ~75s on the
# core test job image pull (v5.46.9 CI speedup).
#
# Version: must track yadgar-ci base version. Bump both together.
FROM docker.io/openfantasy/yadgar-ci:5.121.1

LABEL org.opencontainers.image.source="https://codeberg.org/maxagahi/yadgar"
LABEL org.opencontainers.image.description="yadgar viz CI runner — yadgar-ci + Playwright/Chromium"
LABEL org.opencontainers.image.version="5.121.1"

# Install Playwright + Chromium system deps.
# chromium-driver: Selenium/WebDriver binary (Playwright uses it via PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH).
# The lib packages are Chromium runtime requirements on Debian slim.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        npm \
        chromium \
        chromium-driver \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 && \
    rm -rf /var/lib/apt/lists/*

# Pre-install Playwright Python + pytest-playwright.
# playwright install-deps is skipped (system chromium used via env var).
RUN pip install --no-cache-dir playwright pytest-playwright && \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 playwright install-deps 2>/dev/null || true && \
    rm -rf /root/.cache/pip

# Tell Playwright to use the system chromium (avoid 200 MB own-browser download).
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PYTHONUNBUFFERED=1

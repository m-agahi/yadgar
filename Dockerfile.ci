# ── yadgar-ci: Custom CI runner image ─────────────────────────────────────────
# Base: python:3.14-slim (matches pyproject.toml requires-python>=3.14)
# Purpose: used by .forgejo/workflows/{ci.yaml,release.yaml} container jobs
#          so CI runners can pull from dockerhub (PD-42 carve-out).
# Contains: system deps (make, git, curl, ca-certificates, build-essential)
#           + pre-installed yadgar test + ml extras to speed CI start
#           + SurrealDB v3.1.5 baked in (saves 15-30s CI per run, v5.46.9)
#           + HuggingFace all-MiniLM-L6-v2 baked in (saves 30-60s, v5.46.9)
#           + bsdmainutils for `column` binary (fixes F5 make help failure, v5.46.9)
# Version: updated each CI infrastructure release (v5.46.9+).
FROM python:3.14-slim

LABEL org.opencontainers.image.source="https://codeberg.org/maxagahi/yadgar"
LABEL org.opencontainers.image.description="yadgar CI runner image — Python 3.14 + make + git + test deps + SurrealDB + HF model"
# Version LABEL is build-arg-wired (T4 Car 0 drift fix — was hardcoded 5.121.1
# while pyproject sat at 5.129.0; yadgar-ci has NO auto-sync pipeline, it is
# manually rebuilt/pushed). Pass the current pyproject version at build time:
#   docker build -f Dockerfile.ci --build-arg YADGAR_VERSION=$(python3 scripts/bump_version.py --current-version) .
# The default below documents the version current at the last LABEL touch; the
# authoritative tag is whatever the manual rebuild pushes (ci-pr.yaml pins it).
ARG YADGAR_VERSION=5.130.0
LABEL org.opencontainers.image.version="${YADGAR_VERSION}"

# System deps needed in CI:
#   make             — Makefile integration tests (B6 fix)
#   git              — branch detection, checkout actions
#   curl             — SurrealDB binary download + health checks
#   ca-certificates  — TLS for curl + pip installs
#   build-essential  — C extension builds (scipy, numpy, etc.)
#   nodejs           — JS actions runtime used by Forgejo actions checkout
#   bsdmainutils     — provides `column` binary used by `make help` (F5 fix, v5.46.9)
#   graphviz         — `dot` binary so test_diagram_generator render tests RUN
#                      instead of skipping (hardening Car 3, ADR-0087)
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        make \
        git \
        curl \
        ca-certificates \
        build-essential \
        nodejs \
        bsdmainutils \
        graphviz && \
    rm -rf /var/lib/apt/lists/*

# Bake SurrealDB v3.1.5 into image (saves 15-30s CI per run — no download step).
# SHA256 verified at build time. Binary placed at /usr/local/bin/surreal (on PATH).
ARG SURREAL_VERSION=v3.1.5
ARG SURREAL_SHA256=f7d515203ba0010bde3fc6a5706ce7327d356aca293fbba8424d442f5dcb5002
RUN curl -fsSL \
        "https://github.com/surrealdb/surrealdb/releases/download/${SURREAL_VERSION}/surreal-${SURREAL_VERSION}.linux-amd64.tgz" \
        -o /tmp/surreal.tgz && \
    echo "${SURREAL_SHA256}  /tmp/surreal.tgz" | sha256sum -c - && \
    tar -xzf /tmp/surreal.tgz -C /usr/local/bin surreal && \
    chmod +x /usr/local/bin/surreal && \
    rm /tmp/surreal.tgz

# Pre-install test + ml extras to speed CI pip installs.
# Copies pyproject.toml only so this layer caches across source changes.
WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
COPY uv.lock /app/uv.lock

# Install the FULL [test,ml] extras (deps only — the package itself is installed
# per-run) FROM uv.lock, not from pyproject's open constraints. LOCK PARITY IS
# LOAD-BEARING: an unpinned resolve here pulled starlette>1.0.0 whose testclient
# deprecates plain httpx — invisible while warnings were tolerated, fatal under
# the Car 3 filterwarnings=error gate (57 CI failures, 2026-07-10). CI must run
# the exact versions the repo locks. Legs install only the package itself
# (`uv pip install --system --no-deps -e .`) so nothing re-resolves at run time.
RUN pip install --no-cache-dir uv && \
    uv export --frozen --no-emit-project --extra test --extra ml \
        -o /tmp/requirements-lock.txt && \
    uv pip install --system --no-cache -r /tmp/requirements-lock.txt && \
    rm -f /tmp/requirements-lock.txt && \
    rm -rf /root/.cache/pip /root/.cache/uv

# Bake HuggingFace all-MiniLM-L6-v2 model weights into image
# (saves 30-60s CI per run — no HF download step needed in test jobs).
# Model stored at default HF cache path /root/.cache/huggingface/hub.
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('all-MiniLM-L6-v2'); \
print('HF model all-MiniLM-L6-v2 baked successfully')"

# Bake enrichment seq2seq models into image (v5.72.0 — enables real BC-EN2a/EN3a
# e2e without a runtime HF download). COMET-BART (~1GB) for commonsense triples,
# doc2query/msmarco-t5-small (~230MB) for synthetic queries. Stored at the default
# HF cache /root/.cache/huggingface/hub so CometInferencer/Doc2QueryExpander
# (yadgar/enrichment/_seq2seq.py) load them offline.
# NOTE: ConceptNet (BC-EN1a) is NOT baked — conceptnet_lite's local DB is ~9GB
# (impractical for a CI image); EN1a uses the HTTP API path or stays deferred.
RUN python -c "\
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM; \
AutoTokenizer.from_pretrained('mismayil/comet-bart-ai2'); \
AutoModelForSeq2SeqLM.from_pretrained('mismayil/comet-bart-ai2'); \
AutoTokenizer.from_pretrained('doc2query/msmarco-t5-small-v1'); \
AutoModelForSeq2SeqLM.from_pretrained('doc2query/msmarco-t5-small-v1'); \
print('enrichment seq2seq models (comet-bart + doc2query) baked successfully')"

ENV PYTHONUNBUFFERED=1

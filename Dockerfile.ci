# ── yadgar-ci: Custom CI runner image ─────────────────────────────────────────
# Base: python:3.14-slim (matches pyproject.toml requires-python>=3.14)
# Purpose: used by .forgejo/workflows/{ci.yaml,release.yaml} container jobs
#          so CI runners can pull from dockerhub (PD-42 carve-out).
# Contains: system deps (make, git, curl, ca-certificates, build-essential)
#           + pre-installed yadgar test + ml + sql + analytics extras to speed CI start
#           + SurrealDB v3.1.5 baked in (saves 15-30s CI per run, v5.46.9)
#           + HuggingFace all-MiniLM-L6-v2 baked in (saves 30-60s, v5.46.9)
#           + bsdmainutils for `column` binary (fixes F5 make help failure, v5.46.9)
# Version: updated each CI infrastructure release (v5.46.9+).
FROM python:3.14-slim

LABEL org.opencontainers.image.source="https://github.com/m-agahi/yadgar"
LABEL org.opencontainers.image.description="yadgar CI runner image — Python 3.14 + make + git + test deps + SurrealDB + HF model + Node 22 + gitleaks + bsdmainutils + graphviz"
# Version LABEL is build-arg-wired (T4 Car 0 drift fix — was hardcoded 5.121.1
# while pyproject sat at 5.129.0; yadgar-ci has NO auto-sync pipeline, it is
# manually rebuilt/pushed). Pass the current pyproject version at build time:
#   docker build -f Dockerfile.ci --build-arg YADGAR_VERSION=$(python3 scripts/bump_version.py --current-version) .
# The default below documents the version current at the last LABEL touch; the
# authoritative tag is whatever the manual rebuild pushes (ci-pr.yaml pins it).
ARG YADGAR_VERSION=5.190.0
LABEL org.opencontainers.image.version="${YADGAR_VERSION}"

# Pin the HF cache to a HOME-independent absolute path. The test suite's
# isolate_yadgar_paths fixture monkeypatches $HOME to a tmp dir; without this,
# EmbeddingEngine._is_model_cached() (which resolves the cache from $HOME) and
# huggingface_hub both look in the tmp HOME, miss the baked model, and under
# HF_HUB_OFFLINE=1 (CI) hard-fail — cascading into every embedding-dependent
# test. _is_model_cached() checks $HF_HOME/hub FIRST, so pinning it here makes
# the baked weights discoverable regardless of the HOME redirect.
ENV HF_HOME=/root/.cache/huggingface

# System deps needed in CI:
#   make             — Makefile integration tests (B6 fix)
#   git              — branch detection, checkout actions
#   curl             — SurrealDB binary download + health checks
#   ca-certificates  — TLS for curl + pip installs
#   build-essential  — C extension builds (scipy, numpy, etc.)
#   gpg              — NodeSource apt-key verification for the Node.js 22.x repo
#   nodejs           — JS actions runtime (Forgejo checkout) + opencode plugin
#                      smoke (yadgar/tests/clients/test_hooks_render_opencode_smoke.py:
#                      loads the emitted yadgar-hooks.ts via
#                      `node --experimental-strip-types`, which requires Node
#                      20.19+ for the flag and is stable in 22.6+. Debian 12
#                      bookworm's stock nodejs is 18.20.4 (verified live at
#                      https://packages.debian.org/bookworm/nodejs) — too old.
#                      We install Node 22 from NodeSource so the smoke can run
#                      in CI without an image rebuild on every Node release.
#   bsdmainutils     — provides `column` binary used by `make help` (F5 fix, v5.46.9)
#   graphviz         — `dot` binary so test_diagram_generator render tests RUN
#                      instead of skipping (hardening Car 3, ADR-0087)
# Install Node.js 22 from NodeSource so the opencode plugin smoke
# (node --experimental-strip-types) can run in CI. SHA256 of the
# setup script is checked; the GPG key is verified against
# NodeSource's published keyring. Pinned to the current LTS line
# (22.x); bump in a follow-up train if needed.
# bsdmainutils provides the `column` binary used by `make help`
# (F5 fix, v5.46.9); without it `make help` errors with
# `column: command not found`. Comments MUST live outside the
# RUN block: backticks within `RUN` would be mis-parsed as nested
# command substitutions in sh -c, triggering the EOF error.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        make \
        git \
        curl \
        ca-certificates \
        build-essential \
        gpg \
        bsdmainutils \
        graphviz && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Bake gitleaks v8.30.1 into the image so the pre-commit
# `Detect secrets and credentials` hook runs in CI without a per-run
# download. Pinned to the same version the legacy `validate.yml` was
# downloading (v8.30.1) for one cycle, then bump in a follow-up train.
# Mirrors the SurrealDB binary download below (curl + tar, no install).
ARG GITLEAKS_VERSION=v8.30.1
ARG GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
RUN curl -fsSL \
        "https://github.com/gitleaks/gitleaks/releases/download/${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION#v}_linux_x64.tar.gz" \
        -o /tmp/gitleaks.tgz && \
    echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tgz" | sha256sum -c - && \
    tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks && \
    chmod +x /usr/local/bin/gitleaks && \
    rm /tmp/gitleaks.tgz

# Bake SurrealDB v3.1.5 into image (saves 15-30s CI per run — no download step).
# SHA256 verified at build time. Binary placed at /usr/local/bin/surreal (on PATH).
ARG SURREAL_VERSION=v3.1.5
ARG SURREAL_SHA256=f7d515203ba0010bde3fc6a5706ce7327d356aca293fbba8424d442f5dcb5002
RUN curl -fsSL \
        "https://github.com/surrealdb/surrealdb/releases/download/${SURREAL_VERSION}/surreal-${SURREAL_VERSION}.linux-amd64.tgz" \
        -o /tmp/surreal.tgz && \
    echo "${SURREAL_SHA256}  /tmp/surreal.tgz" | sha256sum -c - && \
    tar -xzf /tmp/surreal.tgz -C /usr/local/bin surreal && \
    chmod +x /usr/local/bin/surreal && \
    rm /tmp/surreal.tgz
# Pre-install test + ml + sql + analytics extras to speed CI pip installs.
# NOTE: this image has no auto-sync pipeline. Editing the extras list here does
# NOT change the image CI currently runs — that needs a rebuild + push. Until
# then the analytics-guarded tests still skip in GitHub CI, and the extras
# receipt the test jobs emit (scripts/check_skip_inventory.py --emit-receipt)
# is what makes that visible instead of silent.
# Copies pyproject.toml only so this layer caches across source changes.
WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
COPY uv.lock /app/uv.lock

# Install the FULL [test,ml,sql,analytics] extras (deps only — the package itself is installed
# per-run) FROM uv.lock, not from pyproject's open constraints. LOCK PARITY IS
# LOAD-BEARING: an unpinned resolve here pulled starlette>1.0.0 whose testclient
# deprecates plain httpx — invisible while warnings were tolerated, fatal under
# the Car 3 filterwarnings=error gate (57 CI failures, 2026-07-10). CI must run
# the exact versions the repo locks. Legs install only the package itself
# (`uv pip install --system --no-deps -e .`) so nothing re-resolves at run time.
RUN pip install --no-cache-dir uv && \
    uv export --frozen --no-emit-project --extra test --extra ml --extra sql --extra analytics \
        -o /tmp/requirements-lock.txt && \
    uv pip install --system --no-cache -r /tmp/requirements-lock.txt && \
    rm -f /tmp/requirements-lock.txt && \
    rm -rf /root/.cache/pip /root/.cache/uv

# Bake HuggingFace all-MiniLM-L6-v2 model weights into image
# (saves 30-60s CI per run — no HF download step needed in test jobs).
# Model stored at default HF cache path /root/.cache/huggingface/hub.
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('all-MiniLM-L6-v2'); \
print('HF model all-MiniLM-L6-v2 baked successfully')"

# Bake CrossEncoder rerankers into image (T4 — enables the offline reranker
# smoke tests: yadgar/tests/backend/test_model_load_smoke.py loads all three
# under HF_HUB_OFFLINE=1). ettin-reranker-32m-v1 = T4 winner / GTE_RERANKER_MODEL
# default; 68m = fallback; gte-reranker-modernbert-base = rollback. All resolve
# offline from /root/.cache/huggingface once baked here.
RUN python -c "\
from sentence_transformers import CrossEncoder; \
CrossEncoder('cross-encoder/ettin-reranker-32m-v1', max_length=512); \
CrossEncoder('cross-encoder/ettin-reranker-68m-v1', max_length=512); \
CrossEncoder('Alibaba-NLP/gte-reranker-modernbert-base', max_length=512); \
print('CE rerankers baked: ettin-32m + ettin-68m + gte-modernbert')"

# Bake enrichment seq2seq models into image (v5.72.0 — enables real BC-EN2a/EN3a
# e2e without a runtime HF download). COMET-BART (~1GB) for commonsense triples,
# doc2query/msmarco-t5-small (~230MB) for synthetic queries. Stored at the default
# HF cache /root/.cache/huggingface/hub so CometInferencer/Doc2QueryExpander
# (yadgar/enrichment/_seq2seq.py) load them offline.
# NOTE: ConceptNet (BC-EN1a) is NOT baked — conceptnet_lite's local DB is ~9GB
# (impractical for a CI image); EN1a uses the HTTP API path or stays deferred.
RUN python -c "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM; AutoTokenizer.from_pretrained('mismayil/comet-bart-ai2'); AutoModelForSeq2SeqLM.from_pretrained('mismayil/comet-bart-ai2'); AutoTokenizer.from_pretrained('doc2query/msmarco-t5-small-v1'); AutoModelForSeq2SeqLM.from_pretrained('doc2query/msmarco-t5-small-v1'); print('enrichment seq2seq models (comet-bart + doc2query) baked successfully')"

# Bake ruff into the image so the pre-commit hooks (which call `ruff`
# as `language: system` entries) find it on PATH. Pinned to 0.15.10
# (same version validate.yml used historically; bump in a follow-up
# if the repo's pre-commit config moves). Placed LAST so the heavy
# model-bake layers above are cache-reusable when only ruff changes
# (a 1-line ARG bump doesn't invalidate the 1GB+ HF model layers).
ARG RUFF_VERSION=0.15.10
RUN pip install --no-cache-dir "ruff==${RUFF_VERSION}" && \
    rm -rf /root/.cache/pip

# License artifacts, at a conventional path in the image. This image is the
# WORST of the four for this: it has no `COPY . /app` (only pyproject.toml +
# uv.lock above), yet it bakes the surreal binary (BUSL-1.1, NOT an Open Source
# license) and gitleaks (MIT) from release tarballs — neither of which carries a
# license into the image. It is pulled from docker.io by every CI job, i.e. it
# is distributed. Placed LAST, next to the ruff bake and for the same reason:
# these files change only on a dependency bump, and putting them earlier would
# invalidate the 1GB+ HF model layers above on every touch.
# Enforced by scripts/check_third_party_licenses.py.
COPY LICENSE NOTICE THIRD-PARTY-LICENSES /usr/share/doc/yadgar/
COPY third-party /usr/share/doc/yadgar/third-party

ENV PYTHONUNBUFFERED=1

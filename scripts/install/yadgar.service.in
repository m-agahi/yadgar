[Unit]
Description=Yadgar Memory Engine / MCP Server (Docker)
After=network.target yadgar-backend.service
Requires=yadgar-backend.service
# The -v @STATE_DIR@ bind below projects the container's
# YADGAR_VACUUM_TRIGGER_PATH write onto the host, where
# yadgar-vacuum-trigger.path watches for it. Both halves are required: the env
# var has no code default, so unset means "no watcher on this surface" and
# vacuum_now() refuses rather than writing into a void.
# @STATE_DIR@ must be spelled IDENTICALLY here and in that unit's PathExists=.

[Service]
Type=notify
NotifyAccess=all
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
EnvironmentFile=@SECRETS_ENV_FILE@
# upgrade.env carries YADGAR_IMAGE_TAG; leading '-' makes missing file non-fatal (first install).
EnvironmentFile=-%h/.local/state/yadgar/upgrade.env
ExecStartPre=-@RUNTIME@ stop yadgar
ExecStartPre=-@RUNTIME@ rm yadgar
# Pre-create the state dir HERE, not only at render time in generate_systemd.sh.
# podman does NOT auto-create a missing `-v` host source — it fails the run with
# `statfs <path>: no such file or directory`. So if the dir is gone at start
# (user cleaned ~/.local/state, or a purge ran between install and boot) the CORE
# daemon would fail to start, not just the vacuum trigger. Mirrors the flake,
# which pre-creates it in this same unit's ExecStartPre for the same reason.
# `mkdir` is resolved from the unit's $PATH, like @RUNTIME@ above.
ExecStartPre=mkdir -p @STATE_DIR@/triggers
ExecStart=@RUNTIME@ run --name yadgar --rm --security-opt label=disable --user root \
    --network yadgar-net \
    -p 127.0.0.1:8765:8765 \
    -p 127.0.0.1:42069:42069 \
    -v @DATA_DIR@:/data \
    -v @STATE_DIR@:/root/.local/state/yadgar \
    -e YADGAR_DB_URL=http://yadgar-backend:8000 \
    -e YADGAR_VACUUM_TRIGGER_PATH=/root/.local/state/yadgar/triggers/vacuum_requested \
    -e YADGAR_EMBED_URL=http://yadgar-backend:8001 \
    -e YADGAR_HOST=0.0.0.0 \
    -e YADGAR_PORT=8765 \
    -e YADGAR_DATA_DIR=/data \
    -e YADGAR_DB_USER=${YADGAR_RW_USER} \
    -e YADGAR_DB_PASS=${YADGAR_RW_PASS} \
    -e YADGAR_RW_USER=${YADGAR_RW_USER} \
    -e YADGAR_RW_PASS=${YADGAR_RW_PASS} \
    -e YADGAR_MCP_AUTH_TOKEN=${YADGAR_MCP_AUTH_TOKEN} \
    --memory 1g --cpus 1 --stop-timeout 30 \
    ${YADGAR_IMAGE_TAG}
ExecStop=@RUNTIME@ stop yadgar
# ExecReload: reserved for future config-only reload; no-op until orchestrator wires it.
ExecReload=/bin/true
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target

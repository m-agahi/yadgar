<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openfantasy.yadgar</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>@YADGAR_INSTALL_PREFIX@</string>

    <!-- Log paths — sed-substituted by generate_launchd.sh (mkdir -p creates the dir) -->
    <key>StandardOutPath</key>
    <string>@YADGAR_HOME@/Library/Logs/yadgar/core.out.log</string>

    <key>StandardErrorPath</key>
    <string>@YADGAR_HOME@/Library/Logs/yadgar/core.err.log</string>

    <!--
        PATH must include /usr/local/bin (Intel podman) and /opt/homebrew/bin (Apple Silicon).
        No DOCKER_HOST: podman-machine manages its own socket lookup on macOS.
        YADGAR_SECRETS_ENV_FILE is set here so the env-file flag can reference it in ProgramArguments.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>YADGAR_SECRETS_ENV_FILE</key>
        <string>@YADGAR_SECRETS_ENV_FILE@</string>
    </dict>

    <!--
        ProgramArguments: /bin/sh -c wrap allows multi-flag podman run without
        per-arg array complexity. Same pattern as systemd ExecStart. sed-substituted.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>@YADGAR_RUNTIME@ run --name yadgar --rm --user root --network yadgar-net --env-file @YADGAR_SECRETS_ENV_FILE@ -p 127.0.0.1:8765:8765 -p 127.0.0.1:42069:42069 -v @YADGAR_INSTALL_PREFIX@:/data -e YADGAR_DB_URL=http://yadgar-backend:8000 -e YADGAR_EMBED_URL=http://yadgar-backend:8001 -e YADGAR_HOST=127.0.0.1 -e YADGAR_PORT=8765 -e YADGAR_DATA_DIR=/data --memory 1g --cpus 1 --stop-timeout 30 @YADGAR_CORE_IMAGE@</string>
    </array>
</dict>
</plist>

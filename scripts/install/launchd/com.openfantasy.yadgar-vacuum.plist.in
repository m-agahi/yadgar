<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openfantasy.yadgar-vacuum</string>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Oneshot: do NOT run at agent load — timer drives this job. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Oneshot: no relaunch after exit (D7). Bare false, not the dict form. -->
    <key>KeepAlive</key>
    <false/>

    <!--
        NOTE: StartCalendarInterval fires in LOCAL TIME, not UTC.
        For the WEEKLY VACUUM that is the correct behaviour, not a compromise:
        the systemd surfaces use 'OnCalendar=Sun *-*-* 04:00:00', which is also
        LOCAL (flake.nix, scripts/install/yadgar-vacuum.timer.in). So all three
        surfaces agree and no timezone workaround is needed here.
        (A previous revision of this comment claimed the nix side was UTC and
        advised setting the Mac's TZ to UTC to match. That was wrong — only the
        NIGHTLY schedule is UTC; see com.openfantasy.yadgar-nightly-cycle.plist.in,
        where the local-time caveat is real.)
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>@YADGAR_INSTALL_PREFIX@</string>

    <!--
        ProgramArguments: invoke wrapper script.
        Wrapper sources secrets.env (launchd has no EnvironmentFile key for host-exec).
        Wall-clock timeout (1800s) enforced inside wrapper via gtimeout/timeout (D3).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>@YADGAR_SCRIPTS_DIR@/yadgar-vacuum-wrapper.sh</string>
    </array>

    <!--
        PATH: homebrew (Intel + Apple Silicon) + ~/.local/bin for pipx yadgar binary.
        No DOCKER_HOST: podman-machine manages its own socket on macOS.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:@YADGAR_HOME@/.local/bin</string>
        <key>YADGAR_SECRETS_ENV_FILE</key>
        <string>@YADGAR_SECRETS_ENV_FILE@</string>
        <!-- Host port the backend plist publishes SurrealDB on. The wrapper builds
             YADGAR_DB_URL from it, so a re-pointed publish is followed here. -->
        <key>YADGAR_BACKEND_SURREAL_PORT</key>
        <string>@YADGAR_BACKEND_SURREAL_PORT@</string>
    </dict>

    <key>StandardOutPath</key>
    <string>@YADGAR_HOME@/.local/share/yadgar/logs/vacuum.out.log</string>

    <key>StandardErrorPath</key>
    <string>@YADGAR_HOME@/.local/share/yadgar/logs/vacuum.err.log</string>
</dict>
</plist>
